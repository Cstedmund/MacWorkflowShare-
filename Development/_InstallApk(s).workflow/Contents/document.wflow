				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>############################################################ 
# Author:      Edmund Tse
# Date:        12 Dec 2025
# Version:     1.0
# 
# Description: 
# 
# 
############################################################ 

#!/bin/bash

############################################
# 0. Fix PATH for Automator
############################################
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

############################################
# 1. Dependency Check (ADB)
############################################
ADB_PATH=""

for p in \
    "$HOME/Library/Android/sdk/platform-tools/adb" \
    "/usr/local/bin/adb" \
    "/opt/homebrew/bin/adb" \
    "/usr/bin/adb"; do
    [[ -x "$p" ]] &amp;&amp; ADB_PATH="$p" &amp;&amp; break
done

[[ -z "$ADB_PATH" &amp;&amp; $(command -v adb) ]] &amp;&amp; ADB_PATH=$(command -v adb)

if [[ -z "$ADB_PATH" ]]; then
    osascript -e 'display dialog "ADB not found.\n\nInstall Android Platform Tools first." buttons {"OK"}'
    exit 1
fi


############################################
# 2. Validate APK selection
############################################
if [[ $# -eq 0 ]]; then
    osascript -e 'display dialog "No APK selected." buttons {"OK"}'
    exit 1
fi


############################################
# 3. Detect devices (authorized / unauthorized)
############################################
AUTHORIZED_DEVICES=$("$ADB_PATH" devices | awk 'NR&gt;1 &amp;&amp; $2=="device" {print $1}')
UNAUTHORIZED_DEVICES=$("$ADB_PATH" devices | awk 'NR&gt;1 &amp;&amp; $2=="unauthorized" {print $1}')

if [[ -n "$UNAUTHORIZED_DEVICES" ]]; then
    osascript -e 'display dialog "Android device unauthorized.\n\nPlease unlock your phone and allow USB debugging.\n\nThen press OK." buttons {"OK"}'
fi

# Re-check after prompt
AUTHORIZED_DEVICES=$("$ADB_PATH" devices | awk 'NR&gt;1 &amp;&amp; $2=="device" {print $1}')
DEVICE_COUNT=$(echo "$AUTHORIZED_DEVICES" | wc -l | tr -d ' ')

if [[ $DEVICE_COUNT -eq 0 ]]; then
    osascript -e 'display dialog "No authorized Android devices found." buttons {"OK"}'
    exit 1
fi


############################################
# 4. Device selection
############################################
if [[ $DEVICE_COUNT -eq 1 ]]; then
    SELECTED_DEVICE="$AUTHORIZED_DEVICES"
else
    LIST_ITEMS=""
    while read -r D; do
        LIST_ITEMS="$LIST_ITEMS \"$D\","
    done &lt;&lt;&lt; "$AUTHORIZED_DEVICES"

    LIST_ITEMS="$LIST_ITEMS \"ALL DEVICES\""

    SELECTED_DEVICE=$(osascript &lt;&lt;EOF
choose from list {${LIST_ITEMS%,}} with prompt "Select device to install APK(s):" default items {"ALL DEVICES"}
EOF
)

    [[ "$SELECTED_DEVICE" == "false" ]] &amp;&amp; exit 0
    SELECTED_DEVICE=$(echo "$SELECTED_DEVICE" | sed 's/,//g')
fi


############################################
# 5. Install APK(s)
############################################
FAIL_COUNT=0

for APK in "$@"; do
    [[ ! -f "$APK" ]] &amp;&amp; continue

    APK_NAME=$(basename "$APK")

    if [[ "$SELECTED_DEVICE" == "ALL DEVICES" ]]; then
        while read -r D; do
            "$ADB_PATH" -s "$D" install -r "$APK" &gt;/dev/null 2&gt;&amp;1 || {
                FAIL_COUNT=$((FAIL_COUNT+1))
                osascript -e "display dialog \"FAILED to install ${APK_NAME} on ${D}\" buttons {\"OK\"}"
            }
        done &lt;&lt;&lt; "$AUTHORIZED_DEVICES"
    else
        "$ADB_PATH" -s "$SELECTED_DEVICE" install -r "$APK" &gt;/dev/null 2&gt;&amp;1 || {
            FAIL_COUNT=$((FAIL_COUNT+1))
            osascript -e "display dialog \"FAILED to install ${APK_NAME}\" buttons {\"OK\"}"
        }
    fi
done


############################################
# 6. Final notification
############################################
if [[ $FAIL_COUNT -eq 0 ]]; then
    osascript -e "display notification \"All APK(s) installed successfully\" with title \"ADB Install\""
else
    osascript -e "display dialog \"Finished with ${FAIL_COUNT} failed install(s).\" buttons {\"OK\"}"
fi

exit 0
</string>
