				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>############################################################ 
# Author:      Edmund Tse
# Date:        12 Dec 2025
# Version:     1.0
# 
# Description: 
# 
# 
############################################################ 

#!/bin/bash

############################################
# 0. Fix PATH inside Automator
############################################
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

############################################
# 1. Check bundletool
############################################

POSSIBLE_BT=(
    "/opt/homebrew/bin/bundletool"
    "/usr/local/bin/bundletool"
    "$HOME/bundletool/bundletool.jar"
)

BUNDLETOOL=""

for p in "${POSSIBLE_BT[@]}"; do
    [[ -f "$p" || -x "$p" ]] &amp;&amp; BUNDLETOOL="$p" &amp;&amp; break
done

[[ -z "$BUNDLETOOL" &amp;&amp; $(command -v bundletool) ]] &amp;&amp; BUNDLETOOL=$(command -v bundletool)

if [[ -z "$BUNDLETOOL" ]]; then
    osascript -e 'display alert "Bundletool Missing" message "Install bundletool:\n\nbrew install bundletool"'
    exit 1
fi


############################################
# 2. Ask for keystore
############################################
KEYSTORE=$(osascript &lt;&lt;EOF
POSIX path of (choose file with prompt "Select your keystore file:")
EOF
)
[[ "$KEYSTORE" == "" ]] &amp;&amp; exit 1


############################################
# 3. Password prompt
############################################
STOREPASS=$(osascript &lt;&lt;EOF
text returned of (display dialog "Enter keystore password:" default answer "" with hidden answer)
EOF
)
[[ -z "$STOREPASS" ]] &amp;&amp; exit 1


############################################
# 4. Extract alias list
############################################
ALIASES=$(keytool -list -v -keystore "$KEYSTORE" -storepass "$STOREPASS" 2&gt;/dev/null | grep "Alias name:" | awk -F': ' '{print $2}')

if [[ -z "$ALIASES" ]]; then
    osascript -e 'display alert "No Alias Found" message "This keystore contains no key alias."'
    exit 1
fi

FIRST_ALIAS=$(echo "$ALIASES" | head -n1)
LIST_ITEMS=$(printf "\"%s\", " $ALIASES)
LIST_ITEMS=${LIST_ITEMS%, }


############################################
# 5. Alias dropdown
############################################
SELECTED_ALIAS=$(osascript &lt;&lt;EOF
choose from list { $LIST_ITEMS } with prompt "Select key alias:" default items {"$FIRST_ALIAS"} OK button name "Use" cancel button name "Cancel"
EOF
)
[[ "$SELECTED_ALIAS" == "false" ]] &amp;&amp; exit 1
SELECTED_ALIAS=$(echo "$SELECTED_ALIAS" | sed 's/,//g')


############################################
# 6. Key Password
############################################
KEYPASS=$(osascript &lt;&lt;EOF
text returned of (display dialog "Enter key password:" default answer "" with hidden answer)
EOF
)
[[ -z "$KEYPASS" ]] &amp;&amp; exit 1


############################################
# 7. Process AAB files
############################################
for AAB in "$@"; do

    [[ ! -f "$AAB" ]] &amp;&amp; continue

    DIR=$(dirname "$AAB")
    BASE=$(basename "$AAB")
    NAME="${BASE%.*}"

    APKS_FILE="$DIR/${NAME}.apks"
    UNIVERSAL_APK="$DIR/${NAME}_universal.apk"
    SIGNED_APK="$DIR/${NAME}_signed.apk"
    ALIGNED_APK="$DIR/${NAME}.apk"

    ############################################
    # 7a. Build universal .apks
    ############################################
    "$BUNDLETOOL" build-apks \
        --bundle="$AAB" \
        --output="$APKS_FILE" \
        --mode=universal \
        --ks="$KEYSTORE" \
        --ks-pass="pass:$STOREPASS" \
        --ks-key-alias="$SELECTED_ALIAS" \
        --key-pass="pass:$KEYPASS"

    if [[ ! -f "$APKS_FILE" ]]; then
        osascript -e "display alert \"Build Failed\" message \"bundletool did not generate the .apks file.\""
        continue
    fi

    ############################################
    # 7b. Extract universal.apk
    ############################################
    #unzip -o "$APKS_FILE" universal.apk -d "$DIR" &gt;/dev/null 2&gt;&amp;1
	(cd "$DIR" &amp;&amp; jar xf "$APKS_FILE" universal.apk)

    if [[ ! -f "$DIR/universal.apk" ]]; then
        osascript -e "display alert \"Extraction Error\" message \"universal.apk not found inside .apks.\nBundletool may have failed.\""
        continue
    fi

    ############################################
    # 7c. Sign APK
    ############################################
    apksigner sign \
        --ks "$KEYSTORE" \
        --ks-pass pass:"$STOREPASS" \
        --ks-key-alias "$SELECTED_ALIAS" \
        --key-pass pass:"$KEYPASS" \
        --out "$SIGNED_APK" \
        "universal.apk"


    ############################################
    # 7d. Align to final APK
    ############################################
    zipalign -f 4 "$SIGNED_APK" "$ALIGNED_APK"


	############################################
	# 7e. Cleanup &amp; rename
	############################################
	# 把 universal.apk 直接變成最終 apk
	mv -f "$DIR/universal.apk" "$DIR/${NAME}.apk"

	# 刪掉 .apks
	rm -f "$APKS_FILE"

    ############################################
    # 7f. Notify
    ############################################
    osascript -e "display notification \"Generated: ${NAME}.apk\" with title \"AAB → APK Complete\""
	
done

exit 0
</string>
					<key>CheckedForUserDefaultShell</key>
