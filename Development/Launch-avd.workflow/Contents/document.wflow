				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>############################################################ 
# Author:      Edmund Tse
# Date:        05 Mar 2026
# Version:     0.1
# 
# Description: 
# 
# 
############################################################ 

#!/bin/bash

############################################
# 1. Locate Android Emulator
############################################

EMULATOR=""

for p in \
"$HOME/Library/Android/sdk/emulator/emulator" \
"/usr/local/share/android-sdk/emulator/emulator" \
"/opt/homebrew/share/android-sdk/emulator/emulator"
do
    [[ -x "$p" ]] &amp;&amp; EMULATOR="$p" &amp;&amp; break
done

if [[ -z "$EMULATOR" ]]; then
    osascript -e 'display dialog "Android Emulator not found.\n\nInstall Android Studio or Android SDK first." buttons {"OK"}'
    exit 1
fi


############################################
# 2. Get AVD list
############################################

AVD_LIST=$("$EMULATOR" -list-avds)

if [[ -z "$AVD_LIST" ]]; then
    osascript -e 'display dialog "No Android Virtual Devices found.\n\nCreate one in Android Studio first." buttons {"OK"}'
    exit 1
fi


############################################
# 3. Count AVDs
############################################

COUNT=$(echo "$AVD_LIST" | wc -l | tr -d " ")

############################################
# 4. If only ONE → launch directly
############################################

if [[ $COUNT -eq 1 ]]; then

    AVD="$AVD_LIST"

    "$EMULATOR" -avd "$AVD" &amp;

    osascript -e "display notification \"Launching $AVD\" with title \"Android Emulator\""

    exit 0
fi


############################################
# 5. Multiple AVDs → dropdown selection
############################################

LIST_ITEMS=""
while read -r AVD; do
    LIST_ITEMS="$LIST_ITEMS \"$AVD\""
done &lt;&lt;&lt; "$AVD_LIST"

CHOICE=$(osascript &lt;&lt;EOF
choose from list {${LIST_ITEMS}} with prompt "Select Android Virtual Device:" OK button name "Launch" cancel button name "Cancel"
EOF
)

[[ "$CHOICE" == "false" ]] &amp;&amp; exit 0

CHOICE=$(echo "$CHOICE" | sed 's/,//g')


############################################
# 6. Launch Emulator
############################################

"$EMULATOR" -avd "$CHOICE" &amp;

osascript -e "display notification \"Launching $CHOICE\" with title \"Android Emulator\""</string>
					<key>CheckedForUserDefaultShell</key>
