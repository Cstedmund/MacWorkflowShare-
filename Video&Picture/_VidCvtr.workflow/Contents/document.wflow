				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>############################################################ 
# Author:      Edmund Tse
# Date:        12 Dec 2025
# Version:     1.0
# 
# Description: 
# 
# 
############################################################ 

#!/bin/bash

############################################
# 1. Find ffmpeg
############################################
FFMPEG_PATH=""

for p in \
    "/opt/homebrew/bin/ffmpeg" \
    "/usr/local/bin/ffmpeg" \
    "/opt/local/bin/ffmpeg" \
    "/usr/bin/ffmpeg"
do
    [[ -x "$p" ]] &amp;&amp; FFMPEG_PATH="$p" &amp;&amp; break
done

[[ -z "$FFMPEG_PATH" &amp;&amp; $(command -v ffmpeg) ]] &amp;&amp; FFMPEG_PATH=$(command -v ffmpeg)

############################################
# 2. Install if missing
############################################
if [[ -z "$FFMPEG_PATH" ]]; then
    osascript -e 'display dialog "ffmpeg not found. Installing using Homebrew…" buttons {"OK"} default button "OK"'

    if ! command -v brew &gt;/dev/null 2&gt;&amp;1; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    brew install ffmpeg
    FFMPEG_PATH=$(command -v ffmpeg)
fi


############################################
# 3. Ask user for output extension
############################################
EXT=$(osascript &lt;&lt;EOF
text returned of (display dialog "Enter output extension (e.g. mp4, mov, mkv, mp3):" default answer "mp4")
EOF
)

# Remove any dots (user might type ".mp4")
EXT="${EXT#.}"

if [[ -z "$EXT" ]]; then
    osascript -e 'display dialog "Invalid extension!" buttons {"OK"}'
    exit 1
fi


############################################
# 4. Process selected files
############################################
if [[ $# -eq 0 ]]; then
    osascript -e 'display dialog "No files selected." buttons {"OK"} default button "OK"'
    exit 1
fi

COUNT=0

for INPUT in "$@"; do
    if [[ ! -f "$INPUT" ]]; then
        continue
    fi

    DIR=$(dirname "$INPUT")
    BASE=$(basename "$INPUT")
    NAME="${BASE%.*}"

    OUTPUT="${DIR}/${NAME}_converted.${EXT}"

    "$FFMPEG_PATH" -i "$INPUT" "$OUTPUT"
    ((COUNT++))
done


############################################
# 5. Final notification
############################################
osascript -e "display notification \"Converted $COUNT file(s) to .$EXT\" with title \"FFmpeg Conversion Done\""
exit 0
</string>
